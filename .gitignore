coverage/
.nyc_output/
*.lcov

# Logs and temporary files
*.log
*.tmp
tmp/
temp/

# Editor and OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Project documents. Only README.md goes to the remote.
*.md
!/README.md

# Gateway admin helper. Owner-local operational tooling, kept out of the remote.
/gateway/scripts/admin.sh
