{
  "name": "flix-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "type-check": "tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply flix-prod-d1-gateway --remote",
    "migrate:local": "wrangler d1 migrations apply flix-prod-d1-gateway --local",
    "invite": "node scripts/create-invite.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.8.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
